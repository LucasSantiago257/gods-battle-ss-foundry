<div class="battle-chat">
  <h3>Nova resistência · {{name}}</h3><p>{{actor.name}} · {{label}} · rodada {{round}}</p>
  <div class="chat-result"><strong>{{total}}</strong><span>{{outcome}}<br>Dificuldade {{difficulty}}</span></div>
  <p>{{#if unlimited}}CE ilimitada{{else}}{{cost}} CE · {{fromCurrent}} atual / {{fromExtra}} extra{{/if}}</p>
  <p>{{#if end}}Controle encerrado{{else}}{{#if success}}Sucesso · prazo mantido{{else}}Falha · prazo mantido{{/if}}{{/if}}</p>
  <details><summary>Dados</summary><p>{{#each results}}{{this}} {{/each}} · modificador {{modifier}}</p>{{#if conditionSummary}}<p>{{conditionSummary}}</p>{{/if}}</details>
  {{#if reason}}<details><summary>Notas</summary><p>{{reason}}</p></details>{{/if}}
</div>
