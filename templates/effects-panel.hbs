<section class="persistent-effects" data-effect-panel><h3>Efeitos com duração</h3>{{#if isGM}}<button type="button" data-action="registerEffect">Adicionar efeito</button><button type="button" data-action="registerSustained">Sustentada</button><button type="button" data-action="depositResidual">Cosmo Residual</button>{{/if}}<p class="effect-deadline-summary">Rodadas pendentes: <strong>{{persistentEffectsPanel.pendingRounds}}</strong> · Recargas pendentes: <strong>{{persistentEffectsPanel.pendingMaintenance}}</strong></p><div class="effect-filter"><label>Buscar efeitos<input type="search" data-effect-query placeholder="Nome, origem, alvo ou página" maxlength="1000"></label><label>Mostrar<select data-effect-scope><option value="all">Todos os registros</option><option value="active">Ativos e pendentes</option><option value="pending">Com parcelas/recargas pendentes</option><option value="history">Histórico</option></select></label><button type="button" data-effect-clear>Limpar filtros</button></div><p data-effect-count role="status" aria-live="polite"></p><h4>Ativos e pendentes ({{persistentEffectsPanel.active.length}})</h4>
{{#each persistentEffectsPanel.active}}{{> "systems/gods-battle-ss/templates/effect-record.hbs"}}{{else}}<p>Nenhum efeito ativo ou pendente.</p>{{/each}}
<details class="calculation-ledger effect-history"><summary>Histórico de efeitos ({{persistentEffectsPanel.history.length}})</summary>
{{#each persistentEffectsPanel.history}}{{> "systems/gods-battle-ss/templates/effect-record.hbs"}}{{else}}<p>Nenhum efeito concluído ou encerrado.</p>{{/each}}
</details></section>
