<div class="battle-layout">
  <header class="battle-header">
    <img class="portrait" src="{{actor.img}}" alt="Retrato de {{actor.name}}">
    <div class="identity"><span class="eyebrow">A BATALHA DOS DEUSES</span><input name="name" class="actor-name" value="{{actor.name}}" aria-label="Nome do cavaleiro" {{#unless editable}}disabled{{/unless}}><span class="edition">UmD10+ · Ficha de cavaleiro</span></div>
    <div class="level-seal"><span>NÍVEL</span><strong>{{system.profile.level}}</strong></div>
  </header>
  <fieldset class="resource-strip" {{#unless editable}}disabled{{/unless}}>
    <label class="resource health"><span>VIDA</span><div><input type="number" step="any" name="system.resources.health.value" value="{{system.resources.health.value}}" aria-label="Vida atual"><span>/ {{system.resources.health.max}}</span></div></label>
    <label class="resource cosmo"><span>COSMO ENERGIA</span><div><input type="number" name="system.resources.cosmo.value" value="{{system.resources.cosmo.value}}" aria-label="Cosmo Energia atual"><span>/ {{#if system.resources.cosmo.unlimited}}∞{{else}}{{system.resources.cosmo.max}}{{/if}}</span></div></label>
    <label class="resource maximum"><span>COSMO MÁXIMO</span><div><input type="number" min="0" max="20" name="system.resources.maximum.value" value="{{system.resources.maximum.value}}" aria-label="Cosmo Máximo"><span>/ 20</span></div></label>
  </fieldset>
  <nav class="tabs battle-tabs" aria-label="Áreas da ficha">{{#each tabs}}<button type="button" data-action="tab" data-group="{{group}}" data-tab="{{id}}" class="{{cssClass}}">{{label}}</button>{{/each}}</nav>
  <div class="sheet-body">
    {{#if canLevelUp}}<button type="button" data-action="beginLevelUp">Subir de nível · evolução assistida</button>{{/if}}
    {{#if interruptedLevel}}<p class="note">Evolução interrompida. O mestre deve conferir o registro e os itens antes de continuar.</p>{{#if isGM}}<button type="button" data-action="clearInterruptedLevel">Liberar após revisão manual</button>{{/if}}{{/if}}
    {{#if levelGuide}}{{> "systems/gods-battle-ss/templates/level-guide.hbs"}}{{/if}}
    {{#if canBeginCreation}}<button type="button" data-action="beginCreation">Abrir assistente de criação de nível 1</button>{{/if}}
    {{#if creationGuide}}<section class="creation-guide"><h3>Criação · etapa {{creationGuide.step}} de 6 · {{creationGuide.current.label}}</h3><p>{{creationGuide.current.hint}}</p><nav class="catalog-links" aria-label="Etapas da criação">{{#each creationGuide.steps}}<button type="button" data-action="guideStep" data-step="{{index}}" {{#unless @root.editable}}disabled{{/unless}}>{{index}}. {{label}}</button>{{/each}}</nav><p><strong>Treino:</strong> {{creationGuide.trainingSpent}} / 8 · restante {{creationGuide.trainingRemaining}}. <strong>Perícias:</strong> {{creationGuide.skillSpent}} / {{creationGuide.skillBudget}} · restante {{creationGuide.skillRemaining}}.</p>
      <details><summary>Escolhas iniciais e revisão</summary><p>Estilo: referências {{creationGuide.initial.page}}. Virtude inicial do estilo: {{creationGuide.initial.virtue}}.</p>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=creationGuide.fields}}<div class="catalog-links"><button type="button" data-action="applyInitialStyle" {{#unless editable}}disabled{{/unless}}>Aplicar / conferir benefícios do estilo</button><button type="button" data-action="chooseCreationItem" data-slot="virtue1" {{#unless editable}}disabled{{/unless}}>Escolher virtude Geral</button><button type="button" data-action="chooseCreationItem" data-slot="virtue2" {{#unless editable}}disabled{{/unless}}>Escolher virtude do estilo</button><button type="button" data-action="chooseCreationItem" data-slot="ability" {{#unless editable}}disabled{{/unless}}>Escolher habilidade inicial</button><button type="button" data-action="chooseCreationItem" data-slot="armor" {{#unless editable}}disabled{{/unless}}>Armadura inicial</button><button type="button" data-action="chooseCreationItem" data-slot="technique" {{#unless editable}}disabled{{/unless}}>Escolher técnica</button></div>{{#each creationGuide.warnings}}<p class="note">Pendência: {{this}}</p>{{/each}}<button type="button" data-action="finishCreation" {{#unless editable}}disabled{{/unless}}>Concluir criação</button><p class="note">Rascunho salvo ao editar. Fechar a ficha não perde o progresso. Concluir registra exceções e conserva as cópias importadas.</p></details>
    </section>{{/if}}
    <section class="tab {{tabs.overview.cssClass}}" data-group="primary" data-tab="overview">
      <div class="attributes">{{#each attributes}}<div class="attribute-card"><button type="button" data-action="rollTest" data-kind="attribute" data-key="{{key}}" {{#unless @root.editable}}disabled{{/unless}}>{{label}} <i class="fa-solid fa-dice"></i></button><input type="number" min="0" max="12" name="system.attributes.{{key}}.value" value="{{value}}" aria-label="Graduação de {{label}}" {{#unless @root.editable}}disabled{{/unless}}><span>Modificador {{mod}}</span><label>Extra <input type="number" name="system.attributes.{{key}}.bonus" value="{{bonus}}" aria-label="Modificador extra de {{label}}" {{#unless @root.editable}}disabled{{/unless}}></label></div>{{/each}}</div>
      <p class="note">Criação: 8 pontos de treino + 1 do estilo, além dos cinco atributos iniciais. Total básico {{system.creation.budget}}; ficha {{system.creation.total}}. Benefícios dos itens conferidos aparecem na memória de Poderes; ajustes e exceções ficam separados.</p>
      <div class="stat-strip">{{#each movement}}<div><span>{{label}}</span><strong>{{value}}</strong></div>{{/each}}</div>
      <h3>Identidade de combate e recursos</h3>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=overview}}
      <details class="calculation-ledger"><summary>Como os valores são calculados</summary>{{#each calculations}}<p><strong>{{label}}</strong>: {{text}}<br><small>Referência: {{page}}</small></p>{{/each}}</details>
    </section>
    <section class="tab {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
      {{#if isGM}}<div class="form-grid"><button type="button" data-action="openTestActors">Abrir fichas de teste</button><button type="button" data-action="importTestActors">Importar grupo de teste</button></div><p class="note">Santo, Guardião e Sábia prontos para exercitar o combate. O grupo é criado em uma pasta própria; repetir preserva as cópias existentes.</p>{{/if}}
      <button type="button" data-action="attackTarget" {{#unless editable}}disabled{{/unless}}>Atacar alvo selecionado</button><p class="note">Marque um cavaleiro como alvo. O defensor resolve sua defesa pelo cartão; depois confirma a aplicação de dano.</p>
      <section class="action-control"><h3>Ações da rodada</h3>{{#if actionControl.error}}<p class="note">{{actionControl.error}}</p>{{else}}{{#if actionControl.enabled}}<p>Rodada {{actionControl.context.round}} · mudar a vez não repõe ações. Defesas e reações podem ser usadas fora da sua vez.</p><div class="stat-strip">{{#each actionControl.entries}}<div><span>{{label}}</span><strong>{{remaining}} / {{max}}</strong><small>{{spent}} gastas</small></div>{{/each}}</div><div class="catalog-links"><button type="button" data-action="consumeAction" data-pool="movement" {{#unless editable}}disabled{{/unless}}>Registrar Movimento</button><button type="button" data-action="consumeAction" data-pool="reaction" {{#unless editable}}disabled{{/unless}}>Registrar Reação</button>{{#if isGM}}<button type="button" data-action="adjustActions">Ajustar reservas · mestre</button>{{/if}}</div>{{else}}<p class="note">Sem encontro iniciado com controle de ações para esta ficha. Rolagens não gastam reservas.</p>{{/if}}{{/if}}{{#if isGM}}{{#if actionControl.canToggle}}<button type="button" data-action="toggleActions">{{#if actionControl.controlEnabled}}Desativar{{else}}Ativar{{/if}} controle de ações no encontro aberto</button>{{else}}<p class="note">Abra um encontro no rastreador de combate para ativar o controle.</p>{{/if}}{{/if}}<p class="note">Técnicas gastam toda a reserva intacta de ataque ou defesa. Movimento/Reação são registros de uso; efeitos e custos de Cosmo continuam conferidos separadamente.</p></section>
      <details class="calculation-ledger"><summary>Histórico de ações e ajustes</summary>{{#each actionLedger}}<p><strong>{{statusLabel}}</strong> · {{label}} · {{cost}} ações{{#if after.context}} · rodada {{after.context.round}}{{/if}}{{#if reason}}<br>{{reason}}{{/if}}{{#if review}}<br>Revisão: {{review.reason}}{{/if}}</p>{{#if canRecover}}<button type="button" data-action="recoverAction" data-operation="{{key}}">Conferir gasto / recuperar cartão</button><button type="button" data-action="reviewAction" data-operation="{{key}}">Encerrar após revisão manual</button>{{/if}}{{else}}<p>Nenhum gasto de ações registrado.</p>{{/each}}{{#each actionAdjustments}}<p><strong>Ajuste do mestre</strong> · {{reason}}<br>Gastas: ataque {{after.spent.attack}}, defesa {{after.spent.defense}}, movimento {{after.spent.movement}}, reação {{after.spent.reaction}}.</p>{{/each}}</details>
      <div class="stat-strip combat-totals">{{#each totals}}<div><span>{{label}}</span><strong>{{value}}</strong></div>{{/each}}</div>
      <h3>Resistências</h3><p class="note">{{resistancePolicy}}</p><div class="resistance-strip">{{#each resistances}}<button type="button" data-action="rollTest" data-kind="resistance" data-key="{{key}}" {{#unless @root.editable}}disabled{{/unless}}>{{label}} · +{{value}} <i class="fa-solid fa-dice"></i></button>{{/each}}</div>
      <h3>Habilidades de luta</h3>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=fighting}}
      <h3>Ajustes de combate</h3>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=combatFields}}
      <h3>Estados</h3>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=conditions}}
      <details class="calculation-ledger"><summary>Histórico de ativações de técnicas</summary>{{#each techniqueLedger}}<p><strong>{{statusLabel}}</strong> · {{name}} · {{payment.cost}} CE{{#if payment.lifeDamage}} · {{payment.lifeDamage}} PV por excesso{{/if}}<br>{{#if after}}CE atual {{before.current}} → {{after.current}} · extra {{before.extra}} → {{after.extra}} · PV {{before.health}} → {{after.health}}{{else}}Recursos no início: CE {{before.current}} · extra {{before.extra}} · PV {{before.health}}. Pagamento aguarda conferência.{{/if}}{{#if review}}<br>Revisão: {{review.reason}}{{/if}}</p>{{#if canRecover}}<button type="button" data-action="recoverTechnique" data-operation="{{key}}">Conferir pagamento / recuperar cartão</button><button type="button" data-action="reviewTechnique" data-operation="{{key}}">Encerrar após reparo manual</button>{{/if}}{{else}}<p>Nenhuma ativação registrada.</p>{{/each}}<p class="note">A recuperação não cobra ou rola novamente. Valores alterados exigem reparo manual; encerrar após revisão não restaura recursos.</p></details>
      <details class="calculation-ledger"><summary>Histórico de aplicações de dano</summary>{{#each damageLedger}}<p><strong>{{statusLabel}}</strong> · PV {{before.health}} → {{after.health}} · armadura {{before.armor}} → {{after.armor}}{{#if reason}}<br>Ajuste: {{reason}}{{/if}}</p>{{#if canRecover}}<button type="button" data-action="recoverDamage" data-operation="{{key}}">Conferir e recuperar operação interrompida</button>{{/if}}{{else}}<p>Nenhuma aplicação registrada.</p>{{/each}}</details>
      <p class="note">Estados, categoria de dano e efeitos de poderes são registros manuais nesta versão. Os bônus dos estilos após o nível 20 são lançados como ajustes. O Nível de Ataque é informado separadamente da PA.</p>
    </section>
    <section class="tab {{tabs.skills.cssClass}}" data-group="primary" data-tab="skills">
      <p class="note">Pontos iniciais sugeridos: {{system.creation.skillBudget}}. Gastos registrados: {{system.progression.skillSpent}}. A aquisição de graduações e os limites são conferidos pelo mestre. Ler Estrelas exige acesso específico.</p>
      <table class="skills-table"><thead><tr><th>Perícia</th><th>Grau</th><th>Atributo</th><th>Extra</th><th>Total</th></tr></thead><tbody>{{#each skills}}
        <tr><td><button type="button" data-action="rollTest" data-kind="skill" data-key="{{key}}" {{#unless @root.editable}}disabled{{/unless}}>{{label}} <i class="fa-solid fa-dice"></i></button></td>
        <td><input type="number" min="0" max="10" name="system.skills.{{key}}.value" value="{{value}}" aria-label="Graduação de {{label}}" {{#unless @root.editable}}disabled{{/unless}}></td>
        <td><select name="system.skills.{{key}}.associated" aria-label="Atributo de {{label}}" {{#unless @root.editable}}disabled{{/unless}}>{{#each associations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><small>{{attributeLabel}}</small></td>
        <td><input type="number" name="system.skills.{{key}}.bonus" value="{{bonus}}" aria-label="Bônus de {{label}}" {{#unless @root.editable}}disabled{{/unless}}></td><td><strong>{{total}}</strong></td></tr>{{/each}}</tbody></table>
    </section>
    <section class="tab {{tabs.techniques.cssClass}}" data-group="primary" data-tab="techniques">
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.technique}}
      <div class="catalog-links"><button type="button" data-action="openCatalog" data-pack="tecnicas">Técnicas do livro</button><button type="button" data-action="openCatalog" data-pack="componentes-tecnicas">Big Bangs e Incrementos do livro</button></div><p class="note">Arraste para a ficha, abra a cópia e configure os parâmetros antes de ativar. Componentes, efeitos específicos e custos variáveis são manuais.</p>
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.bigbang}}
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.increment}}
      <p class="note">Clique no nome para editar a técnica. Ativar gasta CE e publica a rolagem e o dano no chat. Confira pré-requisitos, alcance e ações; aplique o dano ao alvo manualmente.</p>
    </section>
    <section class="tab {{tabs.powers.cssClass}}" data-group="primary" data-tab="powers">
      <div class="catalog-links"><button type="button" data-action="openCatalog" data-pack="habilidades">Habilidades e Dádivas do livro</button><button type="button" data-action="openCatalog" data-pack="virtudes">Virtudes do livro</button><button type="button" data-action="openCatalog" data-pack="cosmo-especial">Combinações de Cosmo</button><button type="button" data-action="openCatalog" data-pack="cosmos-divinos">Cosmos Divinos</button></div>
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.virtue}}
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.ability}}
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.divineCosmo}}
      <details class="calculation-ledger"><summary>Benefícios dos itens e pendências</summary>{{#each passiveLedger}}<p><strong>{{name}}</strong>: {{reason}}{{#each contributions}}<br>{{label}}: {{amount}} {{#if applied}}(considerado){{else}}(não acumulado){{/if}}{{/each}}</p>{{/each}}</details>
      <h3>Vontade</h3>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=will}}
    </section>
    <section class="tab {{tabs.equipment.cssClass}}" data-group="primary" data-tab="equipment">
      {{#if isGM}}<button type="button" data-action="seedCompendium" class="compendium-button"><i class="fa-solid fa-book"></i> Abrir / criar compêndio de modelos</button>{{/if}}
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.armor}}
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.artifact}}
      <p class="note">Arrastar adiciona uma cópia. Equipar aplica PA e CE de uma armadura viva. PV da armadura são editados na própria ficha dela; pré-requisitos, afinidade e acessórios são conferidos pelo mestre.</p>
    </section>
    <section class="tab {{tabs.story.cssClass}}" data-group="primary" data-tab="story">
      <h3>Sentidos e Aura</h3><button type="button" data-action="openCatalog" data-pack="sentidos-auras">Sentidos e Auras do livro</button>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=senseFields}}
      <p class="note">Sentido e estágio não mudam automaticamente com o nível. Preencha os bônus da tabela correspondente; Domínio admite ajuste numérico. Velocidade superada (+) fica registrada para desempates manuais.</p>
      <h3>Evolução</h3>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=progression}}
      {{#if levelRecord}}<details><summary>Última operação de evolução · {{levelRecord.from}} → {{levelRecord.to}} · {{levelRecord.status}}</summary><p>{{levelRecord.error}}</p><p>{{levelRecord.reason}}</p>{{#each levelRecord.choices}}<p>Conteúdo: {{name}}</p>{{/each}}{{#each levelRecord.ranks}}<p>Melhoria {{id}}: {{before}} → {{after}}</p>{{/each}}{{#each levelRecord.summary}}<p>{{label}}: {{before}} → {{after}}</p>{{/each}}{{#each levelRecord.warnings}}<p class="note">Pendência: {{this}}</p>{{/each}}</details>{{/if}}
      {{#if levelHistory}}<details><summary>Histórico de evolução assistida</summary>{{#each levelHistory}}<section><h4>Nível {{from}} → {{to}}</h4><p>{{reason}}</p>{{#each summary}}<p>{{label}}: {{before}} → {{after}}</p>{{/each}}{{#each choices}}<p>Conteúdo: {{name}}</p>{{/each}}{{#each warnings}}<p class="note">Pendência: {{this}}</p>{{/each}}</section>{{/each}}</details>{{/if}}
      <h3>História</h3>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=biography}}
    </section>
  </div>
  <footer class="sheet-footer">Alterações salvas ao editar · Fichas 0.14.0</footer>
</div>

