<div class="battle-layout">
  <header class="battle-header">
    <img class="portrait" src="{{actor.img}}" alt="Retrato de {{actor.name}}">
    <div class="identity"><span class="eyebrow">A BATALHA DOS DEUSES</span><input name="name" class="actor-name" value="{{actor.name}}" aria-label="Nome do cavaleiro" {{#unless editable}}disabled{{/unless}}><span class="edition">UmD10+</span></div>
    <div class="level-seal"><span>NÍVEL</span><strong>{{system.profile.level}}</strong></div>
  </header>
  <fieldset class="resource-strip" {{#unless editable}}disabled{{/unless}}>
    <label class="resource health"><span>VIDA</span><div><input type="number" step="any" name="system.resources.health.value" value="{{system.resources.health.value}}" aria-label="Vida atual"><span>/ {{system.resources.health.max}}</span></div></label>
    <label class="resource cosmo"><span>COSMO ENERGIA</span><div><input type="number" name="system.resources.cosmo.value" value="{{system.resources.cosmo.value}}" aria-label="Cosmo Energia atual"><span>/ {{#if system.resources.cosmo.unlimited}}∞{{else}}{{system.resources.cosmo.max}}{{/if}}</span></div></label>
    <label class="resource maximum"><span>COSMO MÁXIMO</span><div><input type="number" min="0" max="20" name="system.resources.maximum.value" value="{{system.resources.maximum.value}}" aria-label="Cosmo Máximo"><span>/ 20</span></div></label>
  </fieldset>
  <div class="quick-actions" aria-label="Ações de combate">
    <button type="button" class="primary-attack" data-action="attackTarget" {{#unless editable}}disabled{{/unless}}{{#if actionControl.restrictions.attack}}disabled{{/if}}><i class="fa-solid fa-crosshairs" aria-hidden="true"></i> Atacar</button>
    <div class="quick-stat"><span>Ataque</span><strong>{{#if actionControl.enabled}}{{actionControl.remaining.attack}} / {{actionControl.maxima.attack}}{{else}}{{system.combat.attack}}{{/if}}</strong></div><div class="quick-stat"><span>Defesa</span><strong>{{#if actionControl.enabled}}{{actionControl.remaining.defense}} / {{actionControl.maxima.defense}}{{else}}{{system.combat.defense}}{{/if}}</strong></div><div class="quick-stat"><span>Proteção</span><strong>{{system.combat.protection}}</strong></div>
  </div>
  <nav class="tabs battle-tabs" aria-label="Áreas da ficha">{{#each tabs}}<button type="button" data-action="tab" data-group="{{group}}" data-tab="{{id}}" class="{{cssClass}}">{{label}}</button>{{/each}}</nav>
  <div class="sheet-body">
    
    {{#if interruptedLevel}}<p class="note">Evolução interrompida. O mestre deve conferir o registro e os itens antes de continuar.</p>{{#if isGM}}<button type="button" data-action="clearInterruptedLevel">Liberar após revisão manual</button>{{/if}}{{/if}}
    {{#if levelGuide}}{{> "systems/gods-battle-ss/templates/level-guide.hbs"}}{{/if}}
    {{#if canBeginCreation}}<button type="button" data-action="beginCreation">Abrir assistente de criação de nível 1</button>{{/if}}
    {{#if creationGuide}}<section class="creation-guide"><h3>Criação · etapa {{creationGuide.step}} de 6 · {{creationGuide.current.label}}</h3><p>{{creationGuide.current.hint}}</p><nav class="catalog-links" aria-label="Etapas da criação">{{#each creationGuide.steps}}<button type="button" data-action="guideStep" data-step="{{index}}" {{#unless @root.editable}}disabled{{/unless}}>{{index}}. {{label}}</button>{{/each}}</nav><p><strong>Treino:</strong> {{creationGuide.trainingSpent}} / 8 · restante {{creationGuide.trainingRemaining}}. <strong>Perícias:</strong> {{creationGuide.skillSpent}} / {{creationGuide.skillBudget}} · restante {{creationGuide.skillRemaining}}.</p>
      <details><summary>Escolhas iniciais e revisão</summary><p>Estilo: referências {{creationGuide.initial.page}}. Virtude inicial do estilo: {{creationGuide.initial.virtue}}.</p>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=creationGuide.fields}}<div class="catalog-links"><button type="button" data-action="applyInitialStyle" {{#unless editable}}disabled{{/unless}}>Aplicar / conferir benefícios do estilo</button><button type="button" data-action="chooseCreationItem" data-slot="virtue1" {{#unless editable}}disabled{{/unless}}>Escolher virtude Geral</button><button type="button" data-action="chooseCreationItem" data-slot="virtue2" {{#unless editable}}disabled{{/unless}}>Escolher virtude do estilo</button><button type="button" data-action="chooseCreationItem" data-slot="ability" {{#unless editable}}disabled{{/unless}}>Escolher habilidade inicial</button><button type="button" data-action="chooseCreationItem" data-slot="armor" {{#unless editable}}disabled{{/unless}}>Armadura inicial</button><button type="button" data-action="chooseCreationItem" data-slot="technique" {{#unless editable}}disabled{{/unless}}>Escolher técnica</button></div>{{#each creationGuide.warnings}}<p class="note">Pendência: {{this}}</p>{{/each}}<button type="button" data-action="finishCreation" {{#unless editable}}disabled{{/unless}}>Concluir criação</button></details>
    </section>{{/if}}
    <section class="tab {{tabs.overview.cssClass}}" data-group="primary" data-tab="overview">
      <div class="attributes">{{#each attributes}}<div class="attribute-card"><button type="button" data-action="rollTest" data-kind="attribute" data-key="{{key}}" {{#unless @root.editable}}disabled{{/unless}}>{{label}} <i class="fa-solid fa-dice"></i></button><input type="number" min="0" max="12" name="system.attributes.{{key}}.value" value="{{value}}" aria-label="Graduação de {{label}}" {{#unless @root.editable}}disabled{{/unless}}><span>Modificador {{mod}}</span><label>Extra <input type="number" name="system.attributes.{{key}}.bonus" value="{{bonus}}" aria-label="Modificador extra de {{label}}" {{#unless @root.editable}}disabled{{/unless}}></label></div>{{/each}}</div>
      
      <div class="stat-strip">{{#each movement}}<div><span>{{label}}</span><strong>{{value}}</strong></div>{{/each}}</div>
      <h3>Identidade de combate e recursos</h3>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=overview}}
      <details class="calculation-ledger"><summary>Como os valores são calculados</summary>{{#each calculations}}<p><strong>{{label}}</strong>: {{text}}<br><small>Referência: {{page}}</small></p>{{/each}}</details>
    </section>
    <section class="tab {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
      
      
      <section class="action-control"><h3>Ações da rodada</h3>{{#if actionControl.error}}<p class="note">{{actionControl.error}}</p>{{else}}{{#if actionControl.enabled}}<p>Rodada {{actionControl.context.round}}</p><div class="stat-strip">{{#each actionControl.entries}}<div><span>{{label}}</span>{{#if blocked}}<strong>Bloqueada por {{blockedReason}}</strong>{{else}}<strong>{{remaining}} / {{max}}</strong>{{/if}}<small>{{spent}} gastas</small></div>{{/each}}</div><div class="catalog-links"><button type="button" data-action="consumeAction" data-pool="movement" data-movement-mode="partial" {{#unless editable}}disabled{{/unless}}{{#if actionControl.restrictions.movement}}disabled{{/if}}>Movimento Parcial</button><button type="button" data-action="consumeAction" data-pool="movement" data-movement-mode="total" {{#unless editable}}disabled{{/unless}}{{#if actionControl.restrictions.movement}}disabled{{/if}}>Movimento Total</button><button type="button" data-action="consumeAction" data-pool="cosmo" {{#unless editable}}disabled{{/unless}}{{#if actionControl.restrictions.cosmo}}disabled{{/if}}>Ação de Cosmo</button><button type="button" data-action="consumeAction" data-pool="reaction" {{#unless editable}}disabled{{/unless}}{{#if actionControl.restrictions.reaction}}disabled{{/if}}>Reação</button>{{#if isGM}}<button type="button" data-action="adjustActions">Ajustar reservas</button>{{/if}}</div>{{else}}<p class="note">Controle de ações inativo.</p>{{/if}}{{/if}}</section>
      <details class="calculation-ledger"><summary>Histórico de ações e ajustes</summary>{{#each actionLedger}}<p><strong>{{statusLabel}}</strong> · {{label}} · {{cost}} {{#if movementMode}}parcela(s) de movimento{{else}}uso(s)/ações{{/if}}{{#if after.context}} · rodada {{after.context.round}}{{/if}}{{#if reason}}<br>{{reason}}{{/if}}{{#if review}}<br>Revisão: {{review.reason}}{{/if}}</p>{{#if canRecover}}<button type="button" data-action="recoverAction" data-operation="{{key}}">Conferir gasto / recuperar cartão</button><button type="button" data-action="reviewAction" data-operation="{{key}}">Encerrar sem alterar ações</button>{{/if}}{{else}}<p>Nenhum gasto de ações registrado.</p>{{/each}}{{#each actionAdjustments}}<p><strong>Ajuste do mestre</strong> · {{reason}}<br>Gastas: ataque {{after.spent.attack}}, defesa {{after.spent.defense}}, parcelas de movimento {{after.spent.movement}}, reação {{after.spent.reaction}}.{{#if after.cosmoUses}} Ações de Cosmo registradas: {{after.cosmoUses}}.{{/if}}</p>{{/each}}</details>
      <div class="stat-strip combat-totals">{{#each totals}}<div><span>{{label}}</span><strong>{{value}}</strong></div>{{/each}}</div>
      {{> "systems/gods-battle-ss/templates/effects-panel.hbs"}}
      <section class="persistent-effects"><h3>Depósitos de Cosmo Energia</h3>{{#if isGM}}<button type="button" data-action="depositCosmo">Depositar CE em objeto · mestre</button>{{/if}}{{#each cosmoDeposits}}<details class="calculation-ledger"><summary>{{object}} · {{amount}} CE · {{state}}</summary><p>{{source.name}} · p. {{page}} · {{modeLabel}}. Evento: {{event}}.</p>{{#if reason}}<p>{{reason}}</p>{{/if}}{{#if canReturn}}<button type="button" data-action="returnCosmo" data-deposit="{{id}}">{{event}} · devolver {{amount}} CE</button>{{/if}}{{#if return}}<p>CE devolvida · {{return.event}}{{#if return.reason}} · {{return.reason}}{{/if}}</p>{{/if}}</details>{{else}}<p>Nenhum depósito registrado.</p>{{/each}}</section>
      {{#each effectInterruptions}}<p class="note">Efeito pendente · rodada {{round}}{{#if cost}} · {{cost}} CE{{/if}}. Conferir o registro antes de repetir.</p>{{#if canReview}}<button type="button" data-action="recoverEffect" data-operation="{{id}}">Conferir efeito / recuperar cartão · mestre</button>{{/if}}{{/each}}
      <h3>Resistências</h3><div class="resistance-strip">{{#each resistances}}<button type="button" data-action="rollTest" data-kind="resistance" data-key="{{key}}" {{#unless @root.editable}}disabled{{/unless}}>{{label}} · +{{value}} <i class="fa-solid fa-dice"></i></button>{{/each}}</div>
      <details class="sheet-settings"><summary>Habilidades de luta</summary>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=fighting}}</details>
      <details class="sheet-settings"><summary>Ajustes de combate</summary>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=combatFields}}</details>
      <details class="condition-control sheet-settings"><summary>Condições</summary>{{#if isGM}}<button type="button" data-action="registerCondition">Registrar condição assistida · mestre</button>{{/if}}<p>Parcelas nas rolagens: {{conditionControl.modifier}} no modificador · perda de {{conditionControl.dice}} dado(s).</p>{{#if conditionControl.atordoado}}<p>Dano corporal nesta rodada: {{conditionControl.atordoado.bodyDamage}} / {{conditionControl.atordoado.threshold}} PV.{{#if conditionControl.atordoado.exceeded}} Limiar ultrapassado: TAP de Vigor, CD {{conditionControl.atordoado.difficulty}} (10 + dano/10). O registro do estado após falha continua manual.{{else}}{{#if conditionControl.atordoado.atThreshold}}Exatamente 70%; ainda não ultrapassou o limiar.{{else}}Faltam {{conditionControl.atordoado.remaining}} PV para chegar a 70%.{{/if}}{{/if}}</p>{{else}}{{/if}}{{#each conditionControl.entries}}{{#if actionState}}<p><strong>{{label}}</strong> ativo · bloqueios de ação · p.{{page}}.</p>{{else}}<p><strong>{{label}}</strong> × {{count}} · {{modifier}} no modificador · −{{dice}} dado(s) · p.{{page}}.</p>{{/if}}{{/each}}{{#each conditionControl.warnings}}<p class="note">{{label}}: {{reason}}</p>{{/each}}{{#each conditionControl.records}}<details class="calculation-ledger"><summary>{{label}}{{#unless isActionState}} × {{count}}{{/unless}} · {{#if active}}ativo{{else}}encerrado{{/if}}{{#if foreign}} · registro de outra ficha{{/if}}</summary><p>Origem: {{origin}} · ref.: {{page}}.<br>{{details}}</p><p>Encerramento previsto: {{until}}.</p>{{#if reason}}<p>Notas: {{reason}}</p>{{/if}}{{#if editWarning}}<p class="note">{{editWarning}}</p>{{/if}}{{#if hasModifierOverride}}<p>Desorientado: modificador final {{modifierOverride}}, substituindo −4 por sentido.</p>{{/if}}{{#if canEdit}}<button type="button" data-action="editCondition" data-condition="{{id}}">Ajustar condição</button>{{/if}}{{#if canEnd}}<button type="button" data-action="endCondition" data-condition="{{id}}">Encerrar condição</button>{{/if}}{{#each revisions}}<p>Ajuste {{revision}} · quantidade {{before.count}} → {{after.count}} · modificador {{beforeModifier}} → {{afterModifier}} · dados perdidos {{beforeDice}} → {{afterDice}}{{#if after.reason}} · {{after.reason}}{{/if}}</p>{{/each}}{{#if end}}<p>Encerramento: {{end.reason}}</p>{{/if}}</details>{{/each}}</details>
      <details class="sheet-settings"><summary>Marcações de estado</summary>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=conditions}}</details>
      <details class="calculation-ledger"><summary>Histórico de ativações de técnicas</summary>{{#each techniqueLedger}}<p><strong>{{statusLabel}}</strong> · {{name}} · {{payment.cost}} CE{{#if payment.lifeDamage}} · {{payment.lifeDamage}} PV por excesso{{/if}}<br>{{#if after}}CE atual {{before.current}} → {{after.current}} · extra {{before.extra}} → {{after.extra}} · PV {{before.health}} → {{after.health}}{{else}}Recursos no início: CE {{before.current}} · extra {{before.extra}} · PV {{before.health}}. Pagamento aguarda conferência.{{/if}}{{#if review}}<br>Revisão: {{review.reason}}{{/if}}</p>{{#if canRecover}}<button type="button" data-action="recoverTechnique" data-operation="{{key}}">Conferir pagamento / recuperar cartão</button><button type="button" data-action="reviewTechnique" data-operation="{{key}}">Encerrar sem alterar recursos</button>{{/if}}{{else}}<p>Nenhuma ativação registrada.</p>{{/each}}</details>
      <details class="calculation-ledger"><summary>Histórico de aplicações de dano</summary>{{#each damageLedger}}<p><strong>{{statusLabel}}</strong> · PV {{before.health}} → {{after.health}} · armadura {{before.armor}} → {{after.armor}}{{#if reason}}<br>Ajuste: {{reason}}{{/if}}</p>{{#if canRecover}}<button type="button" data-action="recoverDamage" data-operation="{{key}}">Conferir e recuperar operação interrompida</button>{{/if}}{{else}}<p>Nenhuma aplicação registrada.</p>{{/each}}</details>
      
{{#if isGM}}<details class="sheet-tools"><summary>Ferramentas do mestre</summary><div class="form-grid"><button type="button" data-action="openTestActors">Fichas de teste</button><button type="button" data-action="importTestActors">Importar grupo de teste</button></div>{{#if isGM}}{{#if actionControl.canToggle}}<button type="button" data-action="toggleActions">{{#if actionControl.controlEnabled}}Desativar{{else}}Ativar{{/if}} controle de ações no encontro aberto</button>{{else}}<p class="note">Nenhum encontro aberto.</p>{{/if}}{{/if}}</details>{{/if}}
    </section>
    <section class="tab {{tabs.skills.cssClass}}" data-group="primary" data-tab="skills">
      
      <table class="skills-table"><thead><tr><th>Perícia</th><th>Grau</th><th>Atributo</th><th>Extra</th><th>Total</th></tr></thead><tbody>{{#each skills}}
        <tr><td><button type="button" data-action="rollTest" data-kind="skill" data-key="{{key}}" {{#unless @root.editable}}disabled{{/unless}}>{{label}} <i class="fa-solid fa-dice"></i></button></td>
        <td><input type="number" min="0" max="10" name="system.skills.{{key}}.value" value="{{value}}" aria-label="Graduação de {{label}}" {{#unless @root.editable}}disabled{{/unless}}></td>
        <td><select name="system.skills.{{key}}.associated" aria-label="Atributo de {{label}}" {{#unless @root.editable}}disabled{{/unless}}>{{#each associations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><small>{{attributeLabel}}</small></td>
        <td><input type="number" name="system.skills.{{key}}.bonus" value="{{bonus}}" aria-label="Bônus de {{label}}" {{#unless @root.editable}}disabled{{/unless}}></td><td><strong>{{total}}</strong></td></tr>{{/each}}</tbody></table>
    </section>
    <section class="tab {{tabs.techniques.cssClass}}" data-group="primary" data-tab="techniques">
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.technique}}
      <div class="catalog-links"><button type="button" data-action="openCatalog" data-pack="tecnicas">Técnicas do livro</button><button type="button" data-action="openCatalog" data-pack="componentes-tecnicas">Big Bangs e Incrementos do livro</button></div>
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.bigbang}}
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.increment}}
      
    </section>
    <section class="tab {{tabs.powers.cssClass}}" data-group="primary" data-tab="powers">
      <div class="catalog-links"><button type="button" data-action="openCatalog" data-pack="habilidades">Habilidades e Dádivas do livro</button><button type="button" data-action="openCatalog" data-pack="virtudes">Virtudes do livro</button><button type="button" data-action="openCatalog" data-pack="cosmo-especial">Combinações de Cosmo</button><button type="button" data-action="openCatalog" data-pack="cosmos-divinos">Cosmos Divinos</button></div>
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.virtue}}
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.ability}}
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.divineCosmo}}
      <details class="calculation-ledger"><summary>Benefícios dos itens e pendências</summary>{{#each passiveLedger}}<p><strong>{{name}}</strong>: {{reason}}{{#each contributions}}<br>{{label}}: {{amount}} {{#if applied}}(considerado){{else}}(não acumulado){{/if}}{{/each}}</p>{{/each}}</details>
      <h3>Vontade</h3>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=will}}
    </section>
    <section class="tab {{tabs.equipment.cssClass}}" data-group="primary" data-tab="equipment">
      {{#if isGM}}<button type="button" data-action="seedCompendium" class="compendium-button"><i class="fa-solid fa-book"></i> Abrir / criar compêndio de modelos</button>{{/if}}
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.armor}}
      {{> "systems/gods-battle-ss/templates/items.hbs" group=groups.artifact}}
      
    </section>
    <section class="tab {{tabs.story.cssClass}}" data-group="primary" data-tab="story">
      <h3>Sentidos e Aura</h3><button type="button" data-action="openCatalog" data-pack="sentidos-auras">Sentidos e Auras do livro</button>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=senseFields}}
      
      <h3>Evolução</h3>{{#if canLevelUp}}<button type="button" class="level-up-action" data-action="beginLevelUp">Subir de nível</button>{{/if}}{{> "systems/gods-battle-ss/templates/fields.hbs" fields=progression}}
      {{#if levelRecord}}<details><summary>Última operação de evolução · {{levelRecord.from}} → {{levelRecord.to}} · {{levelRecord.status}}</summary><p>{{levelRecord.error}}</p><p>{{levelRecord.reason}}</p>{{#each levelRecord.choices}}<p>Conteúdo: {{name}}</p>{{/each}}{{#each levelRecord.ranks}}<p>Melhoria {{id}}: {{before}} → {{after}}</p>{{/each}}{{#each levelRecord.summary}}<p>{{label}}: {{before}} → {{after}}</p>{{/each}}{{#each levelRecord.warnings}}<p class="note">Pendência: {{this}}</p>{{/each}}</details>{{/if}}
      {{#if levelHistory}}<details><summary>Histórico de evolução assistida</summary>{{#each levelHistory}}<section><h4>Nível {{from}} → {{to}}</h4><p>{{reason}}</p>{{#each summary}}<p>{{label}}: {{before}} → {{after}}</p>{{/each}}{{#each choices}}<p>Conteúdo: {{name}}</p>{{/each}}{{#each warnings}}<p class="note">Pendência: {{this}}</p>{{/each}}</section>{{/each}}</details>{{/if}}
      <h3>História</h3>{{> "systems/gods-battle-ss/templates/fields.hbs" fields=biography}}
    </section>
  </div>
  <footer class="sheet-footer">Alterações salvas ao editar</footer>
</div>

