<div class="battle-chat"><span class="eyebrow">{{kind}}</span><h3>{{label}}</h3><p>Dados: {{#each results}}<span class="die">{{this}}</span> {{/each}}</p><p>Maior {{highest}} + {{tens}} × 2 − {{ones}} × 2 + modificador {{modifier}}</p><div class="chat-result"><strong>{{total}}</strong><span>{{outcome}}<br>Dificuldade {{difficulty}}</span></div></div>
