<div class="battle-chat"><span class="eyebrow">{{kind}}</span><h3>{{label}}</h3>
<div class="chat-result"><strong>{{total}}</strong>{{#if outcome}}<span>{{outcome.hits}} acertos</span>{{else}}<span>Ataques</span>{{/if}}</div>
{{#if actions}}<p class="chat-meta">{{actions.cost}} ações de {{actions.pool}} · rodada {{actions.round}}</p>{{/if}}
{{#if conditionSummary}}<p class="note">{{conditionSummary}}</p>{{/if}}
{{#if fight}}<div class="chat-actions"><button type="button" data-action="quickDefendAttack" hidden>Defender com 1 ação</button><button type="button" data-action="defendAttack">Ajustar defesa</button></div>{{/if}}
{{#if resolvedDamage}}<div class="damage-summary"><strong>{{resolvedDamage.body}} PV</strong>{{#if resolvedDamage.armor}}<span>{{resolvedDamage.armor}} armadura</span>{{/if}}<span class="damage-status" data-damage-status aria-live="polite">Pendente</span></div><div class="chat-actions"><button type="button" data-action="applyDamage">Aplicar dano</button><button type="button" data-action="adjustDamage">Ajustar</button><button type="button" data-action="undoDamage">Desfazer</button></div>{{/if}}
<details class="roll-details"><summary>Detalhes da rolagem</summary><p>{{#each results}}<span class="die">{{this}}</span> {{/each}}</p><p>{{highest}} + {{tens}} × 2 − {{ones}} × 2 + {{modifier}} = {{total}}</p>{{#if outcome}}<p>{{outcome.hits}} × máximo(0, {{outcome.damageLevel}} + {{outcome.damageBonus}} − {{outcome.protection}}) = {{outcome.damage}} PV</p>{{/if}}</details></div>
