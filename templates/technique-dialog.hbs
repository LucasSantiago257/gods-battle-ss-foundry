<section class="technique-activation">
<header class="activation-heading"><strong>{{name}}</strong><span>{{#if areaTargets}}Área · {{areaTargets.length}} alvos{{else}}{{#if targetName}}Alvo: {{targetName}}{{else}}Sem alvo marcado{{/if}}{{/if}}</span></header>
<section class="activation-summary" aria-live="polite">
<div><span>Custo</span><strong data-technique-preview="cost">—</strong></div><div><span>Asterismo · dificuldade</span><strong data-technique-preview="difficulty">—</strong></div><div><span>PC · resistência</span><strong data-technique-preview="powerCosmic">—</strong></div>
</section>
{{#unless nonDamage}}<section class="activation-damage"><span>{{#if areaTargets}}Dano por alvo{{else}}Dano{{/if}}</span><p>Corpo <strong data-technique-preview="damage">—</strong> · crítico <strong data-technique-preview="criticalDamage">—</strong></p><p>Armadura <strong data-technique-preview="armorDamage">—</strong> · crítico <strong data-technique-preview="criticalArmorDamage">—</strong></p></section>{{/unless}}
{{#if isControl}}<p data-technique-preview="duration"></p>{{/if}}
<p class="activation-error" data-technique-preview="error" role="alert"></p><p data-technique-preview="conditions"></p>
{{#if penalty}}<p>Penalidade de Asterismo: {{penalty}}</p>{{/if}}
{{#if movement}}<p>{{movement.label}}{{#if actions.enabled}} · movimento {{actions.remaining.movement}} / {{actions.maxima.movement}} · rodada {{actions.context.round}}{{/if}}</p>{{#if actions.enabled}}<select name="actionPool" aria-label="Ação usada pela técnica"><option value="movement">{{movement.label}}</option></select>{{/if}}{{else}}{{#if actions.enabled}}{{#if areaTargets}}<p>Reservas: ataque + defesa · rodada {{actions.context.round}}</p>{{else}}<label>Reserva usada<select name="actionPool">{{#each actions.techniqueChoices}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#unless available}}disabled{{/unless}}>{{label}}</option>{{/each}}</select></label>{{/if}}{{/if}}{{/if}}
{{#if areaTargets}}<section class="activation-targets"><h4>Alvos desta área</h4><p>Alcance <span data-technique-preview="range"></span></p>
<table><thead><tr><th>Alvo</th><th>Distância</th><th>Situação</th></tr></thead><tbody>{{#each areaTargets}}<tr><td data-area-field="name" data-area-token="{{tokenUuid}}">{{name}}</td><td data-area-field="distanceText" data-area-token="{{tokenUuid}}">—</td><td><span data-area-field="statusText" data-area-token="{{tokenUuid}}">Medição manual</span><span data-area-geometry-state="{{tokenUuid}}"></span></td></tr>{{/each}}</tbody></table>
<button type="button" data-action="refreshArea">Atualizar prévia da área</button>
<details class="activation-options technique-area-geometry"><summary>Forma de referência</summary><label>Forma<select name="areaShape"><option value="none">Sem desenho</option><option value="circle">Círculo</option><option value="cone">Cone</option></select></label>
<div data-area-cone-fields hidden><label>Direção · 0° direita, 90° abaixo<input name="areaDirection" type="text" inputmode="decimal" value="0"></label><label>Abertura · graus<input name="areaAngle" type="text" inputmode="decimal" value="90"></label></div>
<p data-technique-preview="geometryNote"></p><div data-area-geometry-map hidden></div></details></section>
{{else}}<section class="activation-distance"><label class="activation-check"><input name="applyDistance" type="checkbox">Calcular redução por distância</label><p data-technique-preview="distance"></p><p data-technique-preview="distanceReduction"></p><button type="button" data-action="measureTechnique">Atualizar medida</button></section>{{/if}}
{{#if components.enabled}}<details class="activation-options"><summary>Componentes da ativação</summary>
{{#if hasExhaust}}<label>Esgotar · aumentos de ND (+2 CE cada)<input name="exhaust" type="number" min="0" step="1" value="0"></label>{{/if}}
{{#if hasEssence}}<label class="activation-check"><input name="oppositeEssence" type="checkbox">Essência contrária (+1 ND)</label>{{/if}}
{{#if hasTerrain}}<label class="activation-check"><input name="favorableTerrain" type="checkbox">Terreno Favorável (+1 ND)</label>{{/if}}
<label>Notas de contexto (opcional)<input name="componentReason" type="text" maxlength="1000"></label>
{{#each components.rules}}<p>{{label}} · p. {{page}}{{#if detail}} · {{detail}}{{/if}}</p>{{/each}}
{{#each components.manual}}<p>{{name}} · manual · p. {{page}}</p>{{/each}}<p data-technique-preview="components"></p>
{{#unless areaTargets}}<p>Alcance <span data-technique-preview="range"></span></p>{{/unless}}</details>{{/if}}
<details class="activation-options"><summary>CE e Elevar/Condensar</summary><p>{{#if unlimited}}CE ilimitada{{else}}CE atual {{current}} · reservada {{reserve}} · extra {{extra}}{{/if}}</p>
<div class="activation-fields"><label>CE adicional<input name="extra" type="number" min="0" step="1" value="0"></label><label>Elevar Cosmo<input name="elevate" type="number" min="0" step="1" value="0"></label><label>Condensar<input name="condense" type="number" min="0" step="1" value="0"></label></div>
<label class="activation-check">Usar CE extra primeiro<input name="useExtra" type="checkbox" checked></label><label class="activation-check">Queimar PV acima da CE disponível<input name="allowOverload" type="checkbox"></label><p data-technique-preview="payment"></p></details>
<details class="activation-options"><summary>Ajustes do teste</summary><div class="activation-fields"><label>Modificador da situação<input name="bonus" type="number" step="1" value="0"></label><label>Vantagem / desvantagem<select name="advantage"><option value="0">Normal</option><option value="1">Vantagem (+1 dado, +2)</option><option value="-1">Desvantagem (-1 dado, -2)</option></select></label></div></details>
<details class="activation-options"><summary>Cálculos</summary><p>Asterismo <span data-technique-preview="roll"></span></p><p data-technique-preview="area"></p><p data-technique-preview="formula"></p></details>
</section>
