<div class="gods-battle control-retry-dialog">
  <p>Rodada {{round}} · prazo até {{lastRound}}</p>
  <p>{{#if unlimited}}CE ilimitada{{else}}Custo {{cost}} CE{{/if}} · dificuldade {{difficulty}}</p>
  <p>CE atual {{current}} · reservada {{reserved}} · extra {{extra}}</p>
  <p data-control-retry-preview role="status" aria-live="polite"></p>
  <label>Atributo de resistência<select name="attribute"><option value="">Escolher atributo</option>{{#each attributes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
  <details><summary>Ajustes</summary>
    <label>Modificador<input name="bonus" type="number" step="any" value="0" min="-10000" max="10000"></label>
    <label>Vantagem<select name="advantage"><option value="0">Normal</option><option value="1">Vantagem (+1 dado, +2)</option><option value="-1">Desvantagem (-1 dado, -2)</option></select></label>
    <label class="field check-field"><span>Usar CE extra primeiro</span><input name="useExtra" type="checkbox"></label>
    <label>Ao resistir<select name="onSuccess"><option value="end">Encerrar este registro</option><option value="keep">Manter o prazo</option></select></label>
  </details>
  <details><summary>Notas</summary><textarea name="reason" maxlength="2000" aria-label="Notas opcionais"></textarea></details>
</div>
